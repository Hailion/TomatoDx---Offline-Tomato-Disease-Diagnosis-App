{
    "cli": {
        "version": ">= 13.0.0"
    },
    "build": {
        "preview": {
            "android": {
                "buildType": "apk"
            },
            "channel": "preview"
        },
        "production": {
            "android": {
                "buildType": "app-bundle",
                "autoIncrement": true
            },
            "channel": "production"
        },
        "development": {
            "developmentClient": true,
            "android": {
                "buildType": "apk"
            },
            "channel": "development"
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "internal"
            }
        }
    }
}